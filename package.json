{
  "name": "kjv-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start --watch",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "test": "jest",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:core": "playwright test core-functionality.spec.ts --project=chromium",
    "test:rapid": "playwright test tests/last-reference-simple.spec.ts --grep \"should handle rapid navigation gracefully\" --project=chromium --project=firefox",
    "test:working": "playwright test tests/basic-navigation.spec.ts tests/core-functionality.spec.ts tests/last-reference-simple.spec.ts --project=chromium",
