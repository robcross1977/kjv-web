generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_URL")
}

model Admin {
  id      Int      @id @default(autoincrement())
  email    String   @unique
  name     String   @default("Admin")
  
  @@map("admin")
}

model PhoneStatus {
  id      Int      @id @default(autoincrement())
  status  String   @unique
  phones  PhoneNumber[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phone_status")
}

model PhoneNumber {
  id      Int      @id @default(autoincrement())
  number  String
  status  PhoneStatus @relation(fields: [statusId], references: [id])
  statusId Int
  calls   Call[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phone_number")
}

model Call {
  id      Int      @id @default(autoincrement())
  phoneNumber PhoneNumber @relation(fields: [phoneNumberId], references: [id])
  phoneNumberId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("call")
}
