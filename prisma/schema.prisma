generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
  output = "../src/app/types/db"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_URL")
}

model Admin {
  id      Int      @id @default(autoincrement())
  email    String   @unique
  name     String   @default("Admin")
  
  @@map("admin")
}

model PhoneStatus {
  id      Int      @id @default(autoincrement())
  status  String    @unique
  calls  Call[] 

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phone_status")
}

model Phone {
  id      Int      @id @default(autoincrement())
  number  String
  calls   Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phone")
}

model Call {
  id      Int      @id @default(autoincrement())
  phone Phone @relation(fields: [phoneId], references: [id])
  phoneId Int
  status PhoneStatus @relation(fields: [statusId], references: [id])
  statusId Int
  script String
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("call")
}
