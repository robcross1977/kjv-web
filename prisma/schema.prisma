generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "zod-prisma-types"
  output = "../src/app/types/db"
}

datasource db {
  provider = "postgresql"
  url = env("POSTGRES_URL")
}

model User {
  uid      Int      @id @default(autoincrement())
  email    String   @unique
  name     String?
  phone    String?
  role     Role

  @@map("user")
}

enum Role {
  ADMIN
  USER
} 

enum PhoneStatus {
  NEW
  CONTACTED
  NO_ANSWER
  NO_CONTACT
  NO_RESPONSE
  NO_INTEREST
  DO_NOT_CALL
}

model Phone {
  id      Int      @id @default(autoincrement())
  phone  String
  name  String
  status PhoneStatus
  calls   Call[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("phone")
}

enum CallStatus {
  HOLD
  PENDING
  QUEUED
  COMPLETED
  FAILED
}

model Call {
  id      Int      @id @default(autoincrement())
  phone Phone @relation(fields: [phoneId], references: [id])
  phoneId Int
  status CallStatus
  script String
  notes String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("call")
}
